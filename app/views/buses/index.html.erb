<div class="container mt-4">

  <h2 class="text-center fw-bold mb-4">
    All Bus
  </h2>


  <div class="table-responsive">

    <table class="table table-primary table-hover align-middle text-center">

      <thead>
        <tr>
          <th>Bus Name</th>
          <th>Bus Number</th>
          <th>Source</th>
          <th>Destination</th>
          <th>View</th>
          <th>Book</th>
        </tr>
      </thead>


      <tbody>

        <%= render partial: "bus",collection: @buses %>

      </tbody>


    </table>

  </div>

</div>
<div class="d-flex justify-content-center mt-4">
  <%= paginate @buses %>
</div>