
<table class=" table table-primary">

 
  <tbody>
    
     <tr>
     <td><%= bus.bus_name %></td>
      <td><%= bus.bus_number %></td>
      <td><%= bus.source%></td>
      <td><%= bus.destination %></td>
      <td><%= link_to "view_bus", bus_path(bus)%>
