
<table class=" table table-primary">
  <thead>
    <tr>
      <th scope="col">S.No</th>
      <th scope="col">BusName </th>
      <th scope="col">BusNumber </th>
      <th scope="col">Source </th>
      <th scope="col">Destination</th>
      <th scope="col">Arrival</th>
       <th scope="col">Departure</th>
       <th scope="col">Image</th>
      <th scope="col"> other Image</th>
      <th scope="col"> Bus Booking</th>



    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row">1</th>
      <td><%= bus&.bus_name %></td>
      <td><%= bus.bus_number %></td>
      <td><%= bus.source%></td>
      <td><%= bus.destination %></td>
      
       <td><%= bus.arrival_at.strftime("%I:%M %p") %></td>
       <td><%= bus.departure_at.strftime("%I:%M %p") %></td>
       <td>
        <% if @bus.thumbnail_image_id.present?
         thumbnail = @bus.images.find { |img| img.id == @bus.thumbnail_image_id } %>
     
        <%= image_tag thumbnail, width: 100  %>
        <% end %>
        </td>
        <td> <% if @bus.images.attached? %>
               <% @bus.images.each do |image| %>
               <%= image_tag image, width:50,height:50 %>
               <% end %>
              <% else %>
              No Image 
             
          <% end %>
          </td>
          <td> <%= link_to "Book Bus", new_bus_booking_path(bus) %> </td>

            
    </tr>
  
</tbody>

