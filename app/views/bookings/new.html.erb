<div class="container mt-2">
  <h2 class="text-center fw-bold text-primary mt-3 mb-2">
    Select Seat - <%= @bus.bus_name %>
  </h2>
</div>

<%= form_with url: new_bus_booking_path(@bus), method: :get, local: true do |f| %>
  <div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-5">

      <div class="mb-4 text-center">

        <%= f.label :booking_date, "Select Booking Date",class: "form-label fw-bold fs-5" %>

        <%= f.date_field :booking_date,required: true, min: Date.today,value: @booking_date,class: "form-control text-center",onchange: "this.form.submit();" %>

        <% if @bus.errors[:booking_date].any? %>
          <div class="field-error text-danger mt-2">
            <%= @bus.errors.full_messages_for(:booking_date).to_sentence %>
          </div>
        <% end %>

      </div>

    </div>
  </div>
</div>
<% end %>


<div class="container mt-3 mb-5">

  <%= form_with url: bus_bookings_path(@bus), method: :post do |f| %>
<%= hidden_field_tag :booking_date, @booking_date %>

    <div class="row justify-content-center mb-3 mt-2">
      <div class="col-md-6">
      </div>
    </div>

    <div class="row justify-content-center g-2 border rounded-4 shadow-sm p-4 bg-light">

      <% (1..@bus.total_seat).each do |seat_number| %>

        <% booked = @seat.include?(seat_number) %>

        <div class="col-3 col-sm-2 col-md-1 mb-2 text-center">

          <input
            type="checkbox"class="btn-check seat-checkbox"name="seat_number[]"id="seat_<%= seat_number %>"
            value="<%= seat_number %>"
            <%= "disabled" if booked %>>

          <label
            class="btn <%= booked ? 'btn-danger' : 'btn-outline-primary' %> w-100 py-3"
            for="seat_<%= seat_number %>">

            <h4><%= seat_number %></h4>

          </label>

        </div>

      <% end %>

    </div>

    <div class="text-center mt-4">
      <%= f.submit "Book Selected Seat", class: "btn btn-success px-5" %>
    </div>

  <% end %>

</div>

<% if flash[:notice] %>
  <script>
    alert("<%= flash[:notice] %>")
  </script>
<% end %>

<% if flash[:already] %>
  <script>
    alert("<%= flash[:already] %>")
  </script>
<% end %>

<div id="busCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="2000">

  <div class="carousel-indicators">
    <% @bus.images.each_with_index do |image, index| %>
      <button type="button"
              data-bs-target="#busCarousel"
              data-bs-slide-to="<%= index %>"
              class="<%= 'active' if index.zero? %>">
      </button>
    <% end %>
  </div>

  <div class="carousel-inner">
    <% @bus.images.each_with_index do |image, index| %>
      <div class="carousel-item <%= 'active' if index.zero? %>">
        <%= image_tag image,
          class: "d-block w-100 rounded",
          style: "height:350px; object-fit:cover;" %>
      </div>
    <% end %>
  </div>

  <button class="carousel-control-prev"
          type="button"
          data-bs-target="#busCarousel"
          data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>

  <button class="carousel-control-next"
          type="button"
          data-bs-target="#busCarousel"
          data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>

</div>

<script>
let checkboxes = document.querySelectorAll(".seat-checkbox");
checkboxes.forEach(function(checkbox){
  checkbox.addEventListener("change", function(){

    let selectedSeat = document.querySelectorAll(".seat-checkbox:checked");
           this.style="red"
    if (selectedSeat.length > 3) {
      this.checked = false;
      
      alert("You can select maximum 3 seats at a time");
    }

  });

});
</script>