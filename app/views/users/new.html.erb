<% @user.errors.full_messages.each do |message| %>
    <p style="color:red"><%= message %> </p>
    <% end %>

<body style="background-color: #C0C0C0";>

<div style="margin: 0 auto; width:350px;background-color:#898989; padding:10px">

<%= form_with model:@user do |f| %>
        <h3 style="color:green"> REGISTER </h3>
    <%= f.label:firstname %>:
    <%= f.text_field :firstname %>
     <br/> <br/>
    <%= f.label:lastname %>:
    <%= f.text_field :lastname %>
    <br/> <br/>
    
    <%= f.label :contect %>:
    <%= f.telephone_field :contact %>
    <br/> <br/>
    <%= f.label:email %>:
    <%= f.email_field :email%>
    <br/> <br/>
     <%= f.label :password %>:
     <%= f.password_field :password %><br /> <br/>
     <%= f.label :password_confirmation %>:
     <%= f.password_field :password_confirmation %>
     <br/>
    <%= f.radio_button:gender,"male" %>
    <%= f.label :gender_male, "MALE" %>
    
    <%= f.radio_button:gender,"female" %>
    <%= f.label :gender_female, "FEMALE" %>
    <br/> <br/>
    <%= f.select :role, [["Admin","admin"],["User","user"]] %>
   <br/>
    <br/>
    <br/> 
    
   <button style="background-color:green" > <%= f.submit %> </button>
   
    <% end %>
    <div/>

</body>





