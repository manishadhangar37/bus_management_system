<body style="background-color: #C0C0C0";>

<div>


<div style="margin: 0 auto; width:350px;background-color:#898989; padding:10px ">
<h3>Login page </h3>
<%= form_with url:login_path,method: :post do |f| %>
<%= f.label:email %>
<%= f.email_field:email %>
 <br/><br/>
<%= f.label:password %>
<%= f.password_field:password %>
<br/><br/>
<%= f.submit %>
<% end %>
</div>
</div>


 



